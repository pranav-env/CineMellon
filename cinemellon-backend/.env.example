# Copy this file to .env and fill in your own values. Nothing in this file
# is a real credential — .env itself is gitignored, so your real keys never
# get committed.

# ── Server ───────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of origins allowed to call this API. For local dev
# against the Vite frontend, its default port is 5173.
CORS_ORIGIN=http://localhost:5173

# ── TMDB (required for /movie/:id and /search) ──────────────────────────
# Get one free at https://www.themoviedb.org/settings/api — use the "API
# Read Access Token" (the long one, not the short v3 API key), and paste it
# here exactly as shown on that page.
TMDB_ACCESS_TOKEN=

# ── OMDB (optional — fallback movie source when TMDB fails/is unset) ────
# Get a free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# TV shows use TVmaze (https://www.tvmaze.com/api) — no API key needed.

# ── AI provider(s) — required for /ai/movie-insights ────────────────────
# Set whichever you have. If both are set, AI_PROVIDER picks which one is
# used; if AI_PROVIDER is unset, Anthropic is preferred when both keys are
# present. Get an Anthropic key at https://console.anthropic.com/settings/keys
# and a Gemini key at https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# "anthropic" or "gemini" — optional, see above.
AI_PROVIDER=

# Optional model overrides — sensible defaults are used if you leave these
# blank. Only change these if you specifically want a different model.
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-flash

# ── Database ─────────────────────────────────────────────────────────────
# SQLite file path. The default is fine for local dev — it's created
# automatically on first run (npm run seed) and gitignored.
DATABASE_PATH=./data/cinemellon.db
